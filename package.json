{
  "name": "pdf-render-pool",
  "version": "0.1.0",
  "description": "A persistent, concurrency-capped headless-Chromium HTML-to-PDF renderer built on Puppeteer — one warm browser instead of launching/tearing down Chromium per PDF.",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/pool.test.js"
  },
  "peerDependencies": {
    "puppeteer": ">=20"
  },
  "peerDependenciesMeta": {
    "puppeteer": {
      "optional": true
    }
  },
  "keywords": [
    "pdf",
    "puppeteer",
    "chromium",
    "html-to-pdf",
    "render-pool",
    "concurrency"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rcgiri-physics/pdf-render-pool.git"
  },
  "bugs": {
    "url": "https://github.com/rcgiri-physics/pdf-render-pool/issues"
  },
  "author": "Ram Chandra Giri",
  "homepage": "https://github.com/rcgiri-physics/pdf-render-pool#readme"
}
