{
  "name": "pdf-render-pool",
  "version": "0.3.0",
  "description": "A persistent, concurrency-capped headless-Chromium HTML-to-PDF renderer built on Puppeteer — one warm browser instead of launching/tearing down Chromium per PDF.",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.d.mts",
        "default": "./src/index.mjs"
      },
      "require": {
        "types": "./src/index.d.ts",
        "default": "./src/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/pool.test.js test/hardening.test.js",
    "test:integration": "node --test test/integration.test.js",
    "test:coverage": "node --test --experimental-test-coverage test/pool.test.js test/hardening.test.js"
  },
  "peerDependencies": {
    "puppeteer": ">=22"
  },
  "peerDependenciesMeta": {
    "puppeteer": {
      "optional": true
    }
  },
  "keywords": [
    "pdf",
    "puppeteer",
    "chromium",
    "html-to-pdf",
    "render-pool",
    "concurrency"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rcgiri-physics/pdf-render-pool.git"
  },
  "bugs": {
    "url": "https://github.com/rcgiri-physics/pdf-render-pool/issues"
  },
  "author": "Ram Chandra Giri",
  "homepage": "https://rcgiri-physics.github.io/pdf-render-pool/",
  "type": "commonjs",
  "devDependencies": {
    "puppeteer": "^25.13.0"
  }
}
